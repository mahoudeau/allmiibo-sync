node_modules/
dist/
*.log
.DS_Store
.allmiibo-sync.json

# Never commit amiibo dumps or signing keys — a device drive holds
# key_retail.bin alongside your library.
*.bin
# All-in-one containers hold whole libraries, so they matter more than a single
# dump, not less. .fca is not caught by the *.bin rule above.
*.fca
allmiibo-probe*.json
allmiibo-writetest*.json

# Common local library folders. Listed in several cases on purpose: git only
# matches these case-insensitively when core.ignorecase is set, which is the
# default on macOS but not on Linux.
/sync/
/amiibo/
/Amiibo/
/AMIIBO/
/my-amiibo/
/My-Amiibo/
/amiibos/
/Amiibos/
/AMIIBOS/

# Second local library folder
/Allmiibo/

# Amiibo artwork is Nintendo's: no tier is committed. All are fetched locally
# (npm run fetch-images) and deployed to the website, never to the repository.
web/data/images/

# update-db working files
tools/.cache/

# The admin keeps a timestamped copy of the overlay on every save. They are a
# local safety net, not history: the overlay itself is committed, and git is the
# history. Without this a week of editing would add hundreds of near-identical
# files to the repository.
content/backups/

# Deployment — kept local, never committed (server address + credentials).
# A glob rather than the one filename: the site and the admin deploy to
# different places and so have a script each, and the admin's names a subdomain
# that must never reach this repository. test/admin.test.mjs enforces that on
# tracked AND untracked files, so a new deploy script that was not ignored
# would fail the suite rather than leak quietly — but being ignored in the
# first place is the actual protection.
deploy*.sh
runbook-*.md
.env
.env.*
!.env.example

