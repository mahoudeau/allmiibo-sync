{
  "name": "allmiibo-sync",
  "version": "0.1.0",
  "description": "Folder sync for Allmiibo / PIXL NFC emulator devices over Bluetooth LE",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "node serve.mjs",
    "test": "node --test",
    "update-db": "node tools/update-db.mjs",
    "fetch-images": "node tools/fetch-amiibo-images.mjs",
    "admin": "node --env-file=.env server/index.mjs",
    "admin:local": "INSECURE_COOKIES=1 node --env-file=.env server/index.mjs"
  },
  "license": "MIT AND GPL-2.0-only"
}
